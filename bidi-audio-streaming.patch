+++ b/mise.toml
@@ -0,0 +1,56 @@
+[tools]
+python = "3.12"
+node = "22"
+
+[env]
+VIRTUAL_ENV = "{{config_root}}/backend/venv"
+PATH = "{{config_root}}/backend/venv/bin:{{env.PATH}}"
+
+# ── Backend ──────────────────────────────────────────────
+[tasks.venv]
+description = "Create Python venv and install dependencies"
+run = """
+python -m venv backend/venv
+source backend/venv/bin/activate
+pip install -r backend/requirements.txt
+"""
+
+[tasks.backend]
+description = "Start FastAPI backend with auto-reload"
+dir = "backend"
+run = "uvicorn main:app --reload"
+
+# ── Frontend ─────────────────────────────────────────────
+[tasks.install]
+description = "Install frontend npm dependencies"
+dir = "frontend"
+run = "npm install"
+
+[tasks.frontend]
+description = "Start Next.js dev server"
+dir = "frontend"
+run = "npm run dev"
+
+[tasks.build]
+description = "Build Next.js frontend"
+dir = "frontend"
+run = "npm run build"
+
+[tasks.lint]
+description = "Run ESLint on frontend"
+dir = "frontend"
+run = "npm run lint"
+
+[tasks.test]
+description = "Run frontend tests"
