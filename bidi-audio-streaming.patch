@@ -0,0 +1,95 @@
+"use client";
+
+import { useCallback, useRef, useState } from "react";
+
+export interface UseAudioPlayerReturn {
+  /** Whether audio is currently being played */
+  isPlaying: boolean;
+  /** Initialize the player (must be called after user gesture) */
+  init: () => Promise<void>;
+  /** Enqueue a chunk of PCM audio (Int16, 24 kHz mono) for playback */
+  enqueue: (pcmData: ArrayBuffer) => void;
+  /** Signal that no more audio chunks will arrive — play until buffer drains */
+  drain: () => void;
+  /** Stop playback immediately and clear buffer */
+  stop: () => void;
+  /** Any error that occurred */
+  error: string | null;
+}
+
+/**
+ * Hook that wraps the AudioWorklet-based PCM player.
+ *
+ * Plays back PCM audio chunks (24 kHz, 16-bit mono) received from the
+ * server through the `pcm-player-processor.js` worklet.
+ *
+ * Must call `init()` in response to a user gesture (click) to satisfy
+ * browser autoplay policies.
+ */
+export function useAudioPlayer(): UseAudioPlayerReturn {
+  const [isPlaying, setIsPlaying] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const audioContextRef = useRef<AudioContext | null>(null);
+  const workletNodeRef = useRef<AudioWorkletNode | null>(null);
+  const initializedRef = useRef(false);
+
+  const init = useCallback(async () => {
+    if (initializedRef.current) return;
+
+    try {
+      setError(null);
+
+      // 24 kHz to match the server's output PCM rate
+      const audioContext = new AudioContext({ sampleRate: 24000 });
+      audioContextRef.current = audioContext;
+
+      await audioContext.audioWorklet.addModule("/pcm-player-processor.js");
+
+      const workletNode = new AudioWorkletNode(audioContext, "pcm-player-processor");
+      workletNodeRef.current = workletNode;
+
+      // Listen for playback_complete from the worklet
+      workletNode.port.onmessage = (event) => {
+        if (event.data.type === "playback_complete") {
+          setIsPlaying(false);
+        }
+      };
+
+      // Connect worklet to speakers
+      workletNode.connect(audioContext.destination);
+
+      initializedRef.current = true;
+    } catch (err) {
+      const message = err instanceof Error ? err.message : "Failed to init audio player";
+      setError(message);
+      console.error("[useAudioPlayer] init failed:", err);
+    }
+  }, []);
+
+  const enqueue = useCallback((pcmData: ArrayBuffer) => {
+    if (!workletNodeRef.current) {
+      console.warn("[useAudioPlayer] enqueue called before init");
+      return;
+    }
+
+    workletNodeRef.current.port.postMessage(
+      { command: "play", data: pcmData },
+      [pcmData] // Transfer ownership
+    );
+    setIsPlaying(true);
+  }, []);
+
+  const drain = useCallback(() => {
+    if (!workletNodeRef.current) return;
+    workletNodeRef.current.port.postMessage({ command: "drain" });
+  }, []);
+
+  const stop = useCallback(() => {
+    if (!workletNodeRef.current) return;
+    workletNodeRef.current.port.postMessage({ command: "stop" });
+    setIsPlaying(false);
+  }, []);
+
+  return { isPlaying, init, enqueue, drain, stop, error };
+}
diff --git a/frontend/lib/useAudioRecorder.ts b/frontend/lib/useAudioRecorder.ts
new file mode 100644
index 0000000..8498880
--- /dev/null
+++ b/frontend/lib/useAudioRecorder.ts
@@ -0,0 +1,113 @@
+"use client";
+
+import { useCallback, useRef, useState } from "react";
+
+export interface UseAudioRecorderReturn {
+  /** Whether the recorder is actively capturing audio */
+  isRecording: boolean;
+  /** Start recording from the microphone */
+  startRecording: () => Promise<void>;
+  /** Stop recording and release mic */
+  stopRecording: () => void;
+  /** Any error that occurred */
+  error: string | null;
+}
+
+/**
+ * Hook that wraps the AudioWorklet-based PCM recorder.
+ *
+ * Records microphone audio, downsamples to 16 kHz mono Int16 PCM via
+ * the `pcm-recorder-processor.js` worklet, and calls `onAudioData` with
+ * each chunk of raw PCM bytes (ArrayBuffer).
+ */
+export function useAudioRecorder(
+  onAudioData: (pcmData: ArrayBuffer) => void
+): UseAudioRecorderReturn {
+  const [isRecording, setIsRecording] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const audioContextRef = useRef<AudioContext | null>(null);
+  const workletNodeRef = useRef<AudioWorkletNode | null>(null);
+  const streamRef = useRef<MediaStream | null>(null);
+  const sourceRef = useRef<MediaStreamAudioSourceNode | null>(null);
+
+  const startRecording = useCallback(async () => {
+    try {
+      setError(null);
+
+      // Request mic permission
+      const stream = await navigator.mediaDevices.getUserMedia({
+        audio: {
+          sampleRate: 16000,       // Hint — browser may ignore
+          channelCount: 1,
+          echoCancellation: true,
+          noiseSuppression: true,
+          autoGainControl: true,
+        },
+      });
+      streamRef.current = stream;
+
+      // Create AudioContext (browser may use 44.1/48 kHz regardless of hint)
+      const audioContext = new AudioContext({ sampleRate: 16000 });
+      audioContextRef.current = audioContext;
+
+      // Load the PCM recorder worklet
+      await audioContext.audioWorklet.addModule("/pcm-recorder-processor.js");
+
+      const workletNode = new AudioWorkletNode(audioContext, "pcm-recorder-processor");
+      workletNodeRef.current = workletNode;
+
+      // Handle PCM chunks from the worklet
+      workletNode.port.onmessage = (event) => {
+        if (event.data.type === "audio") {
+          onAudioData(event.data.data);
+        }
+      };
+
+      // Connect mic → worklet
+      const source = audioContext.createMediaStreamSource(stream);
+      sourceRef.current = source;
+      source.connect(workletNode);
+      // Don't connect worklet to destination — we don't want to hear our own voice
+
+      // Tell the worklet to start capturing
+      workletNode.port.postMessage({ command: "start" });
+      setIsRecording(true);
+    } catch (err) {
+      const message = err instanceof Error ? err.message : "Failed to start recording";
+      setError(message);
+      console.error("[useAudioRecorder] startRecording failed:", err);
+    }
+  }, [onAudioData]);
+
+  const stopRecording = useCallback(() => {
+    // Tell worklet to stop and flush
+    if (workletNodeRef.current) {
+      workletNodeRef.current.port.postMessage({ command: "stop" });
+      workletNodeRef.current.disconnect();
+      workletNodeRef.current = null;
+    }
+
+    // Disconnect source
+    if (sourceRef.current) {
+      sourceRef.current.disconnect();
+      sourceRef.current = null;
+    }
+
+    // Stop all mic tracks
+    if (streamRef.current) {
+      streamRef.current.getTracks().forEach((track) => track.stop());
+      streamRef.current = null;
+    }
+
+    // Close AudioContext
+    if (audioContextRef.current) {
+      audioContextRef.current.close();
+      audioContextRef.current = null;
+    }
+
+    setIsRecording(false);
+  }, []);
+
+  return { isRecording, startRecording, stopRecording, error };
+}
diff --git a/frontend/lib/useWebSocket.ts b/frontend/lib/useWebSocket.ts
new file mode 100644
index 0000000..2ba01bc
--- /dev/null
+++ b/frontend/lib/useWebSocket.ts
@@ -0,0 +1,150 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+
+const WS_URL = process.env.NEXT_PUBLIC_WS_URL ?? "ws://localhost:8000";
+
+export type ConnectionState = "disconnected" | "connecting" | "connected" | "error";
+
+export interface WsTextMessage {
+  type: "text";
+  text: string;
+}
+
+export interface WsTurnCompleteMessage {
+  type: "turn_complete";
+}
+
+export interface WsErrorMessage {
+  type: "error";
+  message: string;
+}
+
+export type WsServerMessage = WsTextMessage | WsTurnCompleteMessage | WsErrorMessage;
+
+export interface UseWebSocketReturn {
+  /** Current connection state */
+  connectionState: ConnectionState;
+  /** Connect to the bidi WebSocket */
+  connect: (userId: string, sessionId: string) => void;
+  /** Disconnect from the WebSocket */
+  disconnect: () => void;
+  /** Send raw PCM audio bytes to the server */
+  sendAudio: (pcmData: ArrayBuffer) => void;
+  /** Send a text message to the server */
+  sendText: (text: string) => void;
+}
+
+/**
+ * Hook for managing the bidirectional WebSocket connection to the backend.
+ *
+ * Handles:
+ * - Connection lifecycle (connect/disconnect/reconnect)
+ * - Sending binary PCM audio frames and text JSON frames
+ * - Receiving binary audio (→ onAudioData) and text messages (→ onMessage)
+ */
+export function useWebSocket(options: {
+  /** Called when binary audio data is received from the server (PCM 24kHz) */
+  onAudioData: (pcmData: ArrayBuffer) => void;
+  /** Called when a text/JSON message is received */
+  onMessage: (msg: WsServerMessage) => void;
+  /** Called when connection state changes */
+  onConnectionChange?: (state: ConnectionState) => void;
+}): UseWebSocketReturn {
+  const { onAudioData, onMessage, onConnectionChange } = options;
+
+  const [connectionState, setConnectionState] = useState<ConnectionState>("disconnected");
+  const wsRef = useRef<WebSocket | null>(null);
+
+  // Keep callback refs stable to avoid reconnect loops
+  const onAudioDataRef = useRef(onAudioData);
+  const onMessageRef = useRef(onMessage);
+  const onConnectionChangeRef = useRef(onConnectionChange);
+
+  useEffect(() => { onAudioDataRef.current = onAudioData; }, [onAudioData]);
+  useEffect(() => { onMessageRef.current = onMessage; }, [onMessage]);
+  useEffect(() => { onConnectionChangeRef.current = onConnectionChange; }, [onConnectionChange]);
+
+  const updateState = useCallback((state: ConnectionState) => {
+    setConnectionState(state);
+    onConnectionChangeRef.current?.(state);
+  }, []);
+
+  const connect = useCallback((userId: string, sessionId: string) => {
+    // Close existing connection if any
+    if (wsRef.current) {
+      wsRef.current.close();
+      wsRef.current = null;
+    }
+
+    updateState("connecting");
+
+    const url = `${WS_URL}/ws/${encodeURIComponent(userId)}/${encodeURIComponent(sessionId)}`;
+    const ws = new WebSocket(url);
+    ws.binaryType = "arraybuffer";
+    wsRef.current = ws;
+
+    ws.onopen = () => {
+      console.log("[useWebSocket] Connected");
+      updateState("connected");
+    };
+
+    ws.onclose = (event) => {
+      console.log(`[useWebSocket] Closed: code=${event.code} reason=${event.reason}`);
+      wsRef.current = null;
+      updateState("disconnected");
+    };
+
+    ws.onerror = (event) => {
+      console.error("[useWebSocket] Error:", event);
+      updateState("error");
+    };
+
+    ws.onmessage = (event) => {
+      if (event.data instanceof ArrayBuffer) {
+        // Binary frame = PCM audio from the server
+        onAudioDataRef.current(event.data);
+      } else if (typeof event.data === "string") {
+        // Text frame = JSON message
+        try {
+          const msg: WsServerMessage = JSON.parse(event.data);
+          onMessageRef.current(msg);
+        } catch (err) {
+          console.error("[useWebSocket] Failed to parse message:", err);
+        }
+      }
+    };
+  }, [updateState]);
+
+  const disconnect = useCallback(() => {
+    if (wsRef.current) {
+      wsRef.current.close();
+      wsRef.current = null;
+    }
+    updateState("disconnected");
+  }, [updateState]);
+
+  const sendAudio = useCallback((pcmData: ArrayBuffer) => {
+    if (wsRef.current?.readyState === WebSocket.OPEN) {
+      wsRef.current.send(pcmData);
+    }
+  }, []);
+
+  const sendText = useCallback((text: string) => {
+    if (wsRef.current?.readyState === WebSocket.OPEN) {
+      wsRef.current.send(JSON.stringify({ type: "text", text }));
+    }
+  }, []);
+
+  // Cleanup on unmount
+  useEffect(() => {
+    return () => {
+      if (wsRef.current) {
+        wsRef.current.close();
+        wsRef.current = null;
+      }
+    };
+  }, []);
+
+  return { connectionState, connect, disconnect, sendAudio, sendText };
+}
diff --git a/frontend/public/pcm-player-processor.js b/frontend/public/pcm-player-processor.js
new file mode 100644
index 0000000..3923c93
--- /dev/null
+++ b/frontend/public/pcm-player-processor.js
@@ -0,0 +1,104 @@
+/**
+ * AudioWorkletProcessor for playing back PCM audio received from the server.
+ *
+ * Uses a ring buffer to handle asynchronous audio chunk delivery.
+ * Expects 24 kHz, 16-bit mono PCM input (converted to Float32 for playback).
+ *
+ * Messages from the main thread:
+ *   { command: "play", data: ArrayBuffer }  — enqueue PCM chunk for playback
+ *   { command: "stop" }                     — clear buffer, stop playback
+ *
+ * Messages to the main thread:
+ *   { type: "playback_complete" }  — ring buffer has been fully drained
+ */
+
+class PCMPlayerProcessor extends AudioWorkletProcessor {
+  constructor() {
+    super();
+
+    // Ring buffer: ~10 seconds at 24 kHz
+    this._ringBufferSize = 24000 * 10;
+    this._ringBuffer = new Float32Array(this._ringBufferSize);
+    this._writeIndex = 0;
+    this._readIndex = 0;
+    this._samplesAvailable = 0;
+    this._playing = false;
+    this._draining = false; // true when no more data will arrive
+
+    this.port.onmessage = (event) => {
+      const { command, data } = event.data;
+
+      if (command === "play") {
+        this._enqueue(data);
+        this._playing = true;
+        this._draining = false;
+      } else if (command === "stop") {
+        this._playing = false;
+        this._draining = false;
+        this._writeIndex = 0;
+        this._readIndex = 0;
+        this._samplesAvailable = 0;
+      } else if (command === "drain") {
+        // Signal that no more chunks are coming — play until empty
+        this._draining = true;
+      }
+    };
+  }
+
+  /**
+   * Convert Int16 PCM to Float32 and write into ring buffer.
+   */
+  _enqueue(arrayBuffer) {
+    const int16 = new Int16Array(arrayBuffer);
+    const sampleCount = int16.length;
+
+    for (let i = 0; i < sampleCount; i++) {
+      if (this._samplesAvailable >= this._ringBufferSize) {
+        // Buffer full — drop oldest samples (shouldn't happen normally)
+        this._readIndex = (this._readIndex + 1) % this._ringBufferSize;
+        this._samplesAvailable--;
+      }
+
+      // Int16 → Float32
+      this._ringBuffer[this._writeIndex] = int16[i] / 32768.0;
+      this._writeIndex = (this._writeIndex + 1) % this._ringBufferSize;
+      this._samplesAvailable++;
+    }
+  }
+
+  process(inputs, outputs, parameters) {
+    const output = outputs[0];
+    if (!output || !output[0]) {
+      return true;
+    }
+
+    const channel = output[0];
+
+    if (!this._playing) {
+      // Output silence
+      channel.fill(0);
+      return true;
+    }
+
+    for (let i = 0; i < channel.length; i++) {
+      if (this._samplesAvailable > 0) {
+        channel[i] = this._ringBuffer[this._readIndex];
+        this._readIndex = (this._readIndex + 1) % this._ringBufferSize;
+        this._samplesAvailable--;
+      } else {
+        channel[i] = 0; // Silence when buffer is empty
+      }
+    }
+
+    // Notify main thread when draining and buffer is empty
+    if (this._draining && this._samplesAvailable === 0) {
+      this._playing = false;
+      this._draining = false;
+      this.port.postMessage({ type: "playback_complete" });
+    }
+
+    return true; // Keep processor alive
+  }
+}
+
+registerProcessor("pcm-player-processor", PCMPlayerProcessor);
diff --git a/frontend/public/pcm-recorder-processor.js b/frontend/public/pcm-recorder-processor.js
new file mode 100644
index 0000000..743aea5
--- /dev/null
+++ b/frontend/public/pcm-recorder-processor.js
@@ -0,0 +1,113 @@
+/**
+ * AudioWorkletProcessor for recording microphone input as PCM 16-bit mono.
+ *
+ * Receives Float32 audio from the mic (typically 44.1/48 kHz), downsamples
+ * to 16 kHz, converts to Int16 PCM, and posts the raw bytes to the main thread.
+ *
+ * Messages from the main thread:
+ *   { command: "start" }  — begin capturing
+ *   { command: "stop" }   — stop capturing
+ *
+ * Messages to the main thread:
+ *   { type: "audio", data: Int16Array }  — a chunk of 16 kHz PCM audio
+ */
+
+class PCMRecorderProcessor extends AudioWorkletProcessor {
+  constructor() {
+    super();
+    this._recording = false;
+    this._bufferSize = 2048; // samples at source rate before flushing
+    this._buffer = [];
+
+    this.port.onmessage = (event) => {
+      if (event.data.command === "start") {
+        this._recording = true;
+        this._buffer = [];
+      } else if (event.data.command === "stop") {
+        // Flush remaining buffer
+        if (this._buffer.length > 0) {
+          this._flush();
+        }
+        this._recording = false;
+      }
+    };
+  }
+
+  /**
+   * Downsample Float32 audio from sourceSampleRate to 16000 Hz.
+   * Simple linear interpolation — good enough for voice.
+   */
+  _downsample(float32Array, sourceSampleRate) {
+    if (sourceSampleRate === 16000) {
+      return float32Array;
+    }
+
+    const ratio = sourceSampleRate / 16000;
+    const newLength = Math.round(float32Array.length / ratio);
+    const result = new Float32Array(newLength);
+
+    for (let i = 0; i < newLength; i++) {
+      const srcIndex = i * ratio;
+      const lower = Math.floor(srcIndex);
+      const upper = Math.min(Math.ceil(srcIndex), float32Array.length - 1);
+      const frac = srcIndex - lower;
+      result[i] = float32Array[lower] * (1 - frac) + float32Array[upper] * frac;
+    }
+
+    return result;
+  }
+
+  /**
+   * Convert Float32 samples [-1, 1] to Int16 PCM.
+   */
+  _floatToInt16(float32Array) {
+    const int16 = new Int16Array(float32Array.length);
+    for (let i = 0; i < float32Array.length; i++) {
+      const s = Math.max(-1, Math.min(1, float32Array[i]));
+      int16[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
+    }
+    return int16;
+  }
+
+  /**
+   * Flush accumulated buffer: downsample → convert → post to main thread.
+   */
+  _flush() {
+    const float32 = new Float32Array(this._buffer);
+    this._buffer = [];
+
+    const downsampled = this._downsample(float32, sampleRate); // sampleRate is a global in AudioWorklet
+    const pcm16 = this._floatToInt16(downsampled);
+
+    this.port.postMessage(
+      { type: "audio", data: pcm16.buffer },
+      [pcm16.buffer] // Transfer ownership for zero-copy
+    );
+  }
+
+  process(inputs, outputs, parameters) {
+    if (!this._recording) {
+      return true; // Keep processor alive
+    }
+
+    const input = inputs[0];
+    if (!input || !input[0]) {
+      return true;
+    }
+
+    // Take channel 0 (mono)
+    const channelData = input[0];
+    for (let i = 0; i < channelData.length; i++) {
+      this._buffer.push(channelData[i]);
+    }
+
+    // Flush when we've accumulated enough samples
+    if (this._buffer.length >= this._bufferSize) {
+      this._flush();
+    }
+
+    return true; // Keep processor alive
+  }
+}
+
+registerProcessor("pcm-recorder-processor", PCMRecorderProcessor);
diff --git a/mise.toml b/mise.toml
new file mode 100644
index 0000000..193e7ca
