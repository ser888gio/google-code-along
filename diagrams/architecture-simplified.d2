direction: down

# ---------------------------------------------------------------------------
# RS Generator - Architecture Overview (Simplified)
# ---------------------------------------------------------------------------

user: Business User {
  class: users
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

frontend: Frontend (Next.js / React) {
  icon: https://icons.terrastruct.com/dev%2Fnodejs.svg
}

backend: Backend API (FastAPI on Cloud Run) {
  icon: https://icons.terrastruct.com/dev%2Fpython.svg
}

agents: Conversational Agents (ADK + Gemini Pro / Live) {class: rectangle}

pipelines: Background AI Pipelines (Discovery + Finalizer) {class: rectangle}

gemini: Gemini API (direct key) {class: cloud}

firestore: Firestore (session state) {class: cylinder}

gcs: GCS (files + analysis artifacts) {class: cylinder}

bigquery: BigQuery (admin analytics) {class: cylinder}

# --- Flow ------------------------------------------------------------------
user -> frontend: chat + voice
frontend -> backend: "SSE chat, REST, WebSocket"
backend -> agents: run discovery interview
agents -> gemini: inference
backend -> pipelines: extract fields / finalize {style.stroke-dash: 4}
pipelines -> gemini: inference {style.stroke-dash: 4}
pipelines -> firestore: persist fields + analysis {style.stroke-dash: 4}
pipelines -> gcs: final_analysis.json {style.stroke-dash: 4}
backend -> firestore: session state
backend -> gcs: uploads + artifacts
firestore -> bigquery: export views
backend -> bigquery: admin metrics
