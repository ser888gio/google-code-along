direction: down

# ---------------------------------------------------------------------------
# RS Generator - Detailed Infrastructure (Google Cloud)
# Project: vw-skda-fskoda-sandbox-jzf  Region: europe-west4
# Source: .github/workflows/cicd.yaml, backend/Dockerfile, frontend/Dockerfile,
#         docker-compose.yml, infra/*
# ---------------------------------------------------------------------------

user: User Browser {
  class: users
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

gemini: Gemini API (direct key) {class: cloud}

# ----- CI/CD -----------------------------------------------------------------
github: GitHub Actions (cicd.yaml) {
  icon: https://icons.terrastruct.com/dev%2Fdocker.svg
  trigger: "push to develop (paths-filter backend/frontend)" {class: rectangle}
  wif: "Workload Identity Federation (WIF_PROVIDER + SA_EMAIL)" {class: rectangle}
  buildpush: "docker build + push :sha" {class: rectangle}
}

# ----- Google Cloud project --------------------------------------------------
gcp: GCP - vw-skda-fskoda-sandbox-jzf / europe-west4 {
  gar: "Artifact Registry (business-persona-ai-repo)" {
    class: rectangle
    icon: https://icons.terrastruct.com/dev%2Fdocker.svg
  }

  secrets: "Secret Manager (GOOGLE_API_KEY, GCS, FIRESTORE_*, ADMIN_TOKEN)" {class: rectangle}

  run: Cloud Run (managed HTTPS) {
    frontend: "business-persona-ai-frontend (node:22-alpine, :3000)" {
      class: rectangle
      icon: https://icons.terrastruct.com/dev%2Fnodejs.svg
    }
    backend: "business-persona-ai-backend (python:3.12-slim uvicorn, :8080)" {
      class: rectangle
      icon: https://icons.terrastruct.com/dev%2Fpython.svg
    }
  }

  jobs: Cloud Run Jobs (backend image) {
    anomaly: "rs-safety-anomaly-metrics (safety_anomalies)" {class: rectangle}
    redteam: "rs-redteam-daily (run_redteam)" {class: rectangle}
  }

  data: Data plane {
    firestore: "Firestore (sessions, state, analysis, feedback)" {class: cylinder}
    gcs: "GCS bucket (uploads, artifacts, knowledge base)" {class: cylinder}
    bigquery: "BigQuery dataset observability (views + safety table)" {class: cylinder}
  }

  obs: Observability {
    monitoring: "Cloud Monitoring (dashboard, alerts, log metrics)" {class: rectangle}
    trace: "Cloud Trace (OpenTelemetry)" {class: rectangle}
  }
}

# ----- Local dev -------------------------------------------------------------
local: Local dev (docker-compose.yml) {
  lf: "frontend :3000" {class: rectangle}
  lb: "backend :8080 (gcp-key.json mounted)" {class: rectangle}
}

# ===========================================================================
# CI/CD flow
# ===========================================================================
github.trigger -> github.wif: authenticate
github.wif -> github.buildpush
github.buildpush -> gcp.gar: "push backend:sha / frontend:sha"
github.buildpush -> gcp.run.backend: "deploy" {style.stroke-dash: 4}
github.buildpush -> gcp.run.frontend: "deploy" {style.stroke-dash: 4}
gcp.gar -> gcp.run.backend: pull image
gcp.gar -> gcp.run.frontend: pull image
gcp.gar -> gcp.jobs: pull backend image

# ===========================================================================
# Request path
# ===========================================================================
user -> gcp.run.frontend: "HTTPS (UI)"
user -> gcp.run.backend: "HTTPS + WSS (chat / voice)"
gcp.run.frontend -> gcp.run.backend: "NEXT_PUBLIC_API_URL wiring"

# ===========================================================================
# Backend dependencies
# ===========================================================================
gcp.secrets -> gcp.run.backend: "inject secrets at deploy" {style.stroke-dash: 4}
gcp.run.backend -> gemini: "inference (API key)"
gcp.run.backend -> gcp.data.firestore: read/write
gcp.run.backend -> gcp.data.gcs: read/write
gcp.run.backend -> gcp.data.bigquery: admin metrics
gcp.run.backend -> gcp.obs.trace: spans
gcp.run.backend -> gcp.obs.monitoring: metrics / logs

# ===========================================================================
# Data + jobs
# ===========================================================================
gcp.data.firestore -> gcp.data.bigquery: "export -> views" {style.stroke-dash: 4}
gcp.jobs.anomaly -> gcp.data.bigquery: "read sessions, write safety table" {style.stroke-dash: 4}
gcp.jobs.redteam -> gcp.run.backend: "probe staging, assert block rate" {style.stroke-dash: 4}

# ===========================================================================
# Local dev
# ===========================================================================
local.lf -> local.lb: "http://localhost:8080"
local.lb -> gemini: "API key (.env)"
