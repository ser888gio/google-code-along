direction: down

# ---------------------------------------------------------------------------
# RS Generator - Detailed Software Architecture
# ---------------------------------------------------------------------------

user: Business User {
  class: users
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

admin: Admin User {
  class: users
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

# --- Frontend Cloud Run service -------------------------------------------
frontend: Frontend - Next.js / React (Cloud Run) {
  icon: https://icons.terrastruct.com/dev%2Fnodejs.svg

  chat_ui: Chat UI (page.tsx) {class: rectangle}
  rs_preview: RS Live Preview + Panels {class: rectangle}
  api_client: lib/api.ts (HTTP/SSE) {class: rectangle}
  ws_client: useWebSocket + audio hooks {class: rectangle}
  admin_ui: Admin screens {class: rectangle}
}

# --- Backend Cloud Run service --------------------------------------------
backend: Backend - FastAPI + uvicorn (Cloud Run) {
  icon: https://icons.terrastruct.com/dev%2Fpython.svg

  api: API Routers (main.py) {
    class: rectangle
    chat_r: chat /chat/stream {class: rectangle}
    extract_r: discovery /context/extract {class: rectangle}
    ws_r: ws /ws voice {class: rectangle}
    docs_r: documents {class: rectangle}
    diag_r: diagrams {class: rectangle}
    admin_r: admin {class: rectangle}
  }

  engine: Turn Engine + Workflow FSM {
    class: rectangle
    turn: chat_turn.py {class: rectangle}
    fsm: workflow_state.py FSM {class: rectangle}
    classify: answer classifier / quality {class: rectangle}
  }

  adk: Google ADK Runtime {
    orchestrator: Orchestrator Agent (Gemini Pro) {class: rectangle}
    audio: Audio Agent (Gemini Flash Live) {class: rectangle}
    tools: Research tools (GCS search) {class: rectangle}
  }

  bg: Background AI Pipelines {
    class: rectangle
    discovery: Discovery Extractor (Flash Lite) {class: rectangle}
    finalizer: Finalizer (Gemini Pro) {class: rectangle}
  }

  gen: Generation Services {
    class: rectangle
    docs_gen: Docs - PDF/DOCX/SRS {class: rectangle}
    diag_gen: BPMN + Dataflow (Mermaid) {class: rectangle}
  }

  persist: Persistence + Privacy {
    class: rectangle
    fs_writer: firestore/writer.py {class: rectangle}
    gcs_conn: gcs/connector.py {class: rectangle}
    redactor: privacy/redactor.py {class: rectangle}
  }

  obs: Observability + Safety {class: rectangle}
}

# --- External / Google Cloud data plane -----------------------------------
gemini: Gemini API (direct key) {class: cloud}

firestore: Firestore - sessions, fields, workflow, analysis, feedback {class: cylinder}

gcs: GCS - uploads, artifacts, knowledge base {class: cylinder}

bigquery: BigQuery - admin views {class: cylinder}

# ---------------------------------------------------------------------------
# Connections
# ---------------------------------------------------------------------------

# User + frontend
user -> frontend.chat_ui: chat / voice
admin -> frontend.admin_ui: review
frontend.chat_ui -> frontend.api_client
frontend.rs_preview -> frontend.api_client
frontend.chat_ui -> frontend.ws_client: voice

# Frontend -> backend
frontend.api_client -> backend.api.chat_r: "POST /chat/stream (SSE)"
frontend.api_client -> backend.api.extract_r: "POST /context/extract"
frontend.api_client -> backend.api.docs_r: documents
frontend.api_client -> backend.api.diag_r: diagrams
frontend.ws_client -> backend.api.ws_r: "WS PCM frames"
frontend.admin_ui -> backend.api.admin_r: "/admin/*"

# API -> engine -> agents (text chat flow)
backend.api.chat_r -> backend.engine.turn: classify + advance
backend.engine.turn -> backend.engine.fsm
backend.engine.turn -> backend.engine.classify
backend.engine.turn -> backend.adk.orchestrator: hidden context + active field
backend.adk.orchestrator -> gemini: inference
backend.adk.orchestrator -> backend.adk.tools
backend.adk.tools -> gcs: keyword search
backend.adk.orchestrator -> backend.api.chat_r: "stream text + [FINALIZING]"

# Voice flow
backend.api.ws_r -> backend.adk.audio
backend.adk.audio -> gemini: Live audio
backend.adk.audio -> backend.adk.orchestrator: transcript bridge

# Background extraction (async)
backend.api.extract_r -> backend.bg.discovery: {style.stroke-dash: 4}
backend.bg.discovery -> gemini: "extract 28 fields" {style.stroke-dash: 4}
backend.bg.discovery -> backend.persist.fs_writer: {style.stroke-dash: 4}

# Finalization (async background task)
backend.engine.turn -> backend.bg.finalizer: "on [FINALIZING]" {style.stroke-dash: 4}
backend.bg.finalizer -> gemini: "synthesize" {style.stroke-dash: 4}
backend.bg.finalizer -> gcs: "final_analysis.json" {style.stroke-dash: 4}
backend.bg.finalizer -> backend.persist.fs_writer: {style.stroke-dash: 4}

# Generation
backend.api.docs_r -> backend.gen.docs_gen
backend.api.diag_r -> backend.gen.diag_gen
backend.gen.docs_gen -> gcs: rs_template.docx

# Persistence
backend.engine.turn -> backend.persist.redactor: redact
backend.persist.redactor -> backend.persist.fs_writer
backend.persist.fs_writer -> firestore: read/write
backend.persist.gcs_conn -> gcs: read/write
backend.obs -> gemini: cost / safety callbacks

# Admin analytics
firestore -> bigquery: export views
backend.api.admin_r -> bigquery: metrics / sessions
