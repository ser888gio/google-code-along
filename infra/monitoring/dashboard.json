{
  "displayName": "RS Generator - Phase 6 SLIs",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Performance - TTFT p50/p95",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.ttft_seconds'\n| align delta(1m)\n| every 1m\n| group_by [metric.model, metric.phase], [p50: percentile(value.genai_client_ttft_seconds, 50)]"
                },
                "plotType": "LINE"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.ttft_seconds'\n| align delta(1m)\n| every 1m\n| group_by [metric.model, metric.phase], [p95: percentile(value.genai_client_ttft_seconds, 95)]"
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Performance - operation duration p95",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.operation.duration_seconds'\n| align delta(1m)\n| every 1m\n| group_by [metric.operation, metric.status], [p95: percentile(value.genai_client_operation_duration_seconds, 95)]"
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Throughput - Cloud Run request rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.service_name=\"BACKEND_SERVICE_NAME\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Throughput - token usage by feature",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.token.usage'\n| align delta(1m)\n| every 1m\n| group_by [metric.feature, metric.type], [tokens: sum(value.genai_client_token_usage)]"
                },
                "plotType": "STACKED_BAR"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cost - USD/hour by feature",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/genai.client.cost_usd\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.feature", "metric.label.model"]
                    }
                  }
                },
                "plotType": "STACKED_BAR"
              }
            ]
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 8,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cost - cache hit ratio",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/rs.cache.hit_ratio\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["metric.label.model"]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 8,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Operations - emitted on specific flows",
          "text": {
            "content": "Some product and safety metrics are created only after their flows run: feedback votes, session completion, safety finish reasons, cost circuit trips, injection attempts, and anomalous sessions. If a metric descriptor has not been created yet, chart widgets that query it show an error. Add those charts after the first data point exists.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 12,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "Quality, UX, and safety roadmap",
          "text": {
            "content": "Groundedness, hallucination rate, field completeness, and citation accuracy require evaluator metrics that are not emitted yet. Optional emitted-later metrics include `workload.googleapis.com/rs.feedback.vote`, `workload.googleapis.com/rs.session.completion_total`, `workload.googleapis.com/rs.safety.finish_reason_safety`, `workload.googleapis.com/rs.safety.cost_circuit_tripped`, and `workload.googleapis.com/rs.safety.injection_attempt_total`.",
            "format": "MARKDOWN"
          }
        }
      }
    ]
  }
}
