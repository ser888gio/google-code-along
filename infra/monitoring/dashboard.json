{
  "displayName": "RS Generator - Phase 6 SLIs",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Performance - TTFT p50/p95",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.ttft_seconds'\n| align delta(1m)\n| every 1m\n| group_by [metric.model, metric.phase], [p50: percentile(value.genai_client_ttft_seconds, 50)]"
                },
                "plotType": "LINE"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.ttft_seconds'\n| align delta(1m)\n| every 1m\n| group_by [metric.model, metric.phase], [p95: percentile(value.genai_client_ttft_seconds, 95)]"
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Performance - LLM operation duration p95 (by operation, status)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.operation.duration_seconds'\n| align delta(1m)\n| every 1m\n| group_by [metric.operation, metric.status], [p95: percentile(value.genai_client_operation_duration_seconds, 95)]"
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Throughput - Cloud Run request rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.service_name=\"BACKEND_SERVICE_NAME\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Errors - Cloud Run non-2xx response rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.service_name=\"BACKEND_SERVICE_NAME\" metric.label.response_code_class!=\"2xx\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.response_code_class"]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Performance - backend request latency p95",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.service_name=\"BACKEND_SERVICE_NAME\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95"
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Throughput - token usage by feature",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.token.usage'\n| align delta(1m)\n| every 1m\n| group_by [metric.feature, metric.type], [tokens: sum(value.genai_client_token_usage)]"
                },
                "plotType": "STACKED_BAR"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 12,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cost - USD/hour by feature",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/genai.client.cost_usd\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.feature", "metric.label.model"]
                    }
                  }
                },
                "plotType": "STACKED_BAR"
              }
            ]
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 12,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cost - cache hit ratio",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/rs.cache.hit_ratio\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["metric.label.model"]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 12,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Quality - discovery field completeness p50/p95",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/rs.discovery.field.completeness_ratio'\n| align delta(1m)\n| every 1m\n| group_by [], [p50: percentile(value.rs_discovery_field_completeness_ratio, 50)]"
                },
                "plotType": "LINE"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/rs.discovery.field.completeness_ratio'\n| align delta(1m)\n| every 1m\n| group_by [], [p95: percentile(value.rs_discovery_field_completeness_ratio, 95)]"
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 16,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Resources - CPU utilization p99",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" resource.type=\"cloud_run_revision\" resource.label.service_name=\"BACKEND_SERVICE_NAME\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MEAN"
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 16,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Resources - memory utilization p99",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" resource.type=\"cloud_run_revision\" resource.label.service_name=\"BACKEND_SERVICE_NAME\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MEAN"
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 16,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Resources - instance count (by state)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\" resource.label.service_name=\"BACKEND_SERVICE_NAME\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.state"]
                    }
                  }
                },
                "plotType": "STACKED_AREA"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 20,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Product - document & diagram generation p95 (by operation, status)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/genai.client.operation.duration_seconds'\n| filter metric.operation =~ 'document.*' || metric.operation =~ 'diagram.*'\n| align delta(1m)\n| every 1m\n| group_by [metric.operation, metric.status], [p95: percentile(value.genai_client_operation_duration_seconds, 95)]"
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 20,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Product - finalization outcomes (success/error)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch generic_task\n| metric 'workload.googleapis.com/rs.finalization.status_total'\n| align delta(1m)\n| every 1m\n| group_by [metric.status], [count: sum(value.rs_finalization_status_total)]"
                },
                "plotType": "STACKED_BAR"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 24,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "Reliability - infra error events (log-based)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/firestore_unavailable_total\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                },
                "plotType": "LINE"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/bridge_injection_failure_total\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                },
                "plotType": "LINE"
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 28,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "Emitted-on-first-use & roadmap signals",
          "text": {
            "content": "Some metric descriptors are created only after their flow runs for the first time, so their charts error until the first data point exists: `rs.finalization.status_total`, `rs.discovery.field.completeness_ratio`, and the log-based reliability metrics. Still not emitted (roadmap, evaluator-backed): groundedness, hallucination rate, citation accuracy, and field accept/dismiss counts. Other emitted-later product/safety metrics available to chart: `rs.feedback.vote`, `rs.session.completion_total`, `rs.session.duration_seconds`, `genai.client.itl_seconds`, `rs.safety.finish_reason_safety`, `rs.safety.cost_circuit_tripped`, `rs.safety.injection_attempt_total`, `rs.safety.anomalous_session`.",
            "format": "MARKDOWN"
          }
        }
      }
    ]
  }
}
